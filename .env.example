# ============================================================================
# CREDENCIAIS DE FALLBACK LOCAL (QUANDO SUPABASE NÃO ESTIVER CONFIGURADO)
# Copie este arquivo para .env e insira suas credenciais.
# O arquivo .env está protegido no .gitignore e bloqueado no .htaccess.
# ============================================================================
ADMIN_EMAIL="admin@meusoftware.com"
ADMIN_PASSWORD="admin123"
# Opcional: Se preferir usar hash BCRYPT no lugar de texto puro em ADMIN_PASSWORD:
ADMIN_PASSWORD_HASH=""

# ============================================================================
# SUPABASE AUTH & DATABASE (FRONTEND REACT + BACKEND PHP)
# Obtenha em: https://supabase.com/dashboard -> Project Settings -> API
# IMPORTANTE: Nunca exponha a chave secret / service_role em variáveis VITE_!
# Use a Publishable Key (sb_publishable_...) ou Anon Key pública no frontend.
# ============================================================================
VITE_SUPABASE_URL="https://SEU_PROJETO_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_chave_publishable_ou_anon_aqui"

SUPABASE_URL="https://SEU_PROJETO_ID.supabase.co"
SUPABASE_ANON_KEY="sua_chave_publishable_ou_anon_aqui"
# Opcional (apenas para uso exclusivo interno do backend PHP, nunca enviada ao navegador):
SUPABASE_KEY=""
